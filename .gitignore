# 가상환경 폴더
venv/
env/
.venv/

# 파이썬 캐시 및 임시 파일
__pycache__/
*.py[cod]
*.pyo

# Jupyter notebook 체크포인트
.ipynb_checkpoints/

# 환경설정 파일
.env
.env.*

# Mac OS, Windows 등 시스템 파일
.DS_Store
Thumbs.db

# VSCode 세팅
.vscode/
.history/

# Claude Code
.claude/

# 로그, 결과, 임시파일
*.log
*.tmp

# 기타 빌드/배포
dist/
build/
*.egg-info/

# YOLO 학습 결과 (runs/ 폴더는 ultralytics가 자동 생성)
runs/
cockroach_detection/
*_detection/

# 모델 파일 (best.pt만 제외하고 나머지 .pt 파일 무시)
*.pt
!models/best.pt
!models/*.pt

# 데이터셋 이미지 (data.yaml만 추적)
dataset/train/images/
dataset/train/labels/
dataset/valid/images/
dataset/valid/labels/
dataset/test/images/
dataset/test/labels/
!dataset/data.yaml

# 결과 폴더
results/*/
results/**/*.jpg
results/**/*.png